<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for the macOS .app bundle.

  CMake configures this file (the .plist.in suffix is what triggers that) and
  substitutes the MACOSX_BUNDLE_* variables below. The spelling of those
  variables matches the ones CMake itself defines for the default template.
  Note the braces: CMake's plist generator resolves dollar-brace VAR
  references and leaves a bare at-sign VAR at-sign untouched, so the
  at-sign spelling silently produced an empty value for every key.

  Beyond the standard keys this adds the two things a macOS user expects from
  a Markdown reader:

    - CFBundleDocumentTypes: makes Finder offer MDReader for .md files, and
      lets "Open With" remember the choice. Without it the app launches but
      never appears in the file's "Open With" menu.
    - LSMinimumSystemVersion: Big Sur (11) is the floor. The app is tested
      against macOS Sequoia 15.8.1, but nothing in it needs anything newer
      than Big Sur, so we do not lock out older machines unnecessarily.
-->
<plist version="1.0">
<dict>
  <!-- The app's default UI language is English (简体中文 is switched on
       inside the app), so the bundle's development region follows. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
  <key>CFBundleIconFile</key>
  <string>${MACOSX_BUNDLE_ICON_FILE}</string>
  <key>CFBundleIdentifier</key>
  <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
  <key>CFBundleDisplayName</key>
  <string>MDReader</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
  <key>CFBundleVersion</key>
  <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
  <key>CFBundleGetInfoString</key>
  <string>${MACOSX_BUNDLE_INFO_STRING}</string>
  <key>NSHumanReadableCopyright</key>
  <string>${MACOSX_BUNDLE_COPYRIGHT}</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Retina: the preview is a Chromium view, so it must render at device
       pixel ratio rather than being upscaled by the window server. -->
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <!-- Finder integration: open .md / .markdown files with MDReader. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Markdown Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>net.daringfireball.markdown</string>
        <string>public.plain-text</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>md</string>
        <string>markdown</string>
        <string>mdown</string>
        <string>mkd</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
